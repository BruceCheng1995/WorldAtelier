{
  "name": "world-atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node tools/start-workspace.mjs",
    "doctor": "node tools/check-deployment.mjs",
    "test:deployment": "node --test tests/creation/deployment-check.test.mjs",
    "background:install": "node tools/workspace-background.mjs install",
    "background:status": "node tools/workspace-background.mjs status",
    "background:uninstall": "node tools/workspace-background.mjs uninstall",
    "build:runtime": "node tools/build-runtime.mjs",
    "test": "npm run test:creation:unit",
    "test:defaults": "node --test tests/creation/default-projects-independent.test.mjs tests/creation/play-entry-validation.test.mjs",
    "test:defaults:browser": "node tests/creation/default-projects-browser.mjs",
    "test:legacy": "node --test tests/e2e/central.test.mjs",
    "test:creation:unit": "node --test tests/creation/canonical-game-project.test.mjs tests/creation/unified-game-bridge.test.mjs tests/creation/native-shared-bridge.test.mjs tests/creation/native-fine-merge.test.mjs tests/creation/native-merge-agent.test.mjs tests/creation/play-context-buffer.test.mjs tests/creation/play-observations.test.mjs tests/creation/session-continuations.test.mjs tests/creation/agent-text-boundary.test.mjs tests/creation/agent-skills.test.mjs",
    "test:creation:engine": "node --test --test-concurrency=1 tests/creation/play-context-engine.test.mjs tests/creation/native-offline-roundtrip.test.mjs",
    "start:preview": "node tools/start-workspace.mjs",
    "dev": "node tools/start-workspace.mjs",
    "build:preview": "node tools/build-model-preview.mjs",
    "build:linux-sandbox": "node tools/build-linux-sandbox.mjs",
    "admin:bind": "node tools/configure-admin.mjs",
    "test:admin": "node --test tests/creation/admin-independent.test.mjs"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "three": "0.185.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
